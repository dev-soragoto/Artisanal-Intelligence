{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artisanal Intelligence",
  "version": "0.1.0",
  "identifier": "dev.soragoto.artisanal-intelligence",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "能工智人 · Artisanal Intelligence",
        "width": 1120,
        "height": 820,
        "minWidth": 680,
        "minHeight": 600,
        "backgroundColor": "#111713"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
