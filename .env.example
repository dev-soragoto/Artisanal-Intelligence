# Required whenever HOST is not loopback, including the Docker image.
ARTISANAL_API_KEY=replace-with-agent-api-key
ARTISANAL_OPERATOR_PASSWORD=replace-with-operator-password

# Comma-separated browser origins allowed to operate a separately hosted console.
# Same-origin production deployment does not require this setting.
ARTISANAL_OPERATOR_ORIGINS=

# Optional lifecycle and cookie settings.
ARTISANAL_REQUEST_TIMEOUT_MS=300000
ARTISANAL_OPERATOR_SESSION_TTL_MS=43200000
ARTISANAL_OPERATOR_COOKIE_SECURE=0
ARTISANAL_OPERATOR_COOKIE_SAMESITE=strict
