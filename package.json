{
  "name": "artisanal-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tauri dev",
    "desktop:dev": "npm run desktop:prepare && npm run dev:web",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run desktop:prepare && tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "start": "tauri dev --no-dev-server --no-watch --config src-tauri/tauri.local.json",
    "build:desktop": "tauri build --no-bundle",
    "bundle": "tauri build",
    "check:desktop": "npm run desktop:prepare && cargo check --manifest-path src-tauri/Cargo.toml",
    "start:server": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@tauri-apps/api": "2.11.1",
    "fastify": "5.12.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "esbuild": "0.28.2",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  }
}
